# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-value

# MongoDB Atlas or self-hosted MongoDB
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.example.mongodb.net/abes_academic_hub

# Nodemailer SMTP account. For Microsoft 365 use smtp.office365.com and port 587.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@abes.ac.in
SMTP_PASS=replace-with-the-mailbox-password-or-app-password
MAIL_FROM="ABES Academic Hub <no-reply@abes.ac.in>"

# Optional AI evaluator endpoint. It must implement an OpenAI-compatible chat/completions API.
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=paste-rotated-key-here
AI_MODEL=gpt-4.1-mini
DEMO_AI=false
